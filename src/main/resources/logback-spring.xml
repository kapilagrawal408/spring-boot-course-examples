<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- 1. Define Variables -->
  <property name="LOGS_HOME" value="./logs"/>
  <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
  <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
  
  <property name="LOG_FILE_INFO" value="${LOGS_HOME}/info.log"/>
  <property name="LOG_FILE_ERROR" value="${LOGS_HOME}/error.log"/>
  
  <!-- Import Spring Boot defaults -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />

  <!-- 2. Console Appender (No rolling policy allowed here) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
    </encoder>
  </appender>
  
  <!-- 3. INFO File Appender -->
  <appender name="LOG_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE_INFO}</file>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
    </encoder>
	<!-- The Rolling Policy defines WHEN the current log file should be closed and saved, and WHEN a fresh log file should be created. 'TimeBasedRollingPolicy' means the clock is the only trigger. -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOGS_HOME}/info-%d{yyyy-MM-dd}.log</fileNamePattern>
      <!-- maxHistory is the built-in cleanup mechanism to prevent disk exhaustion. Because our pattern above rolls daily, this '30' translates to "keep the last 30 days". On day 31, Logback will automatically delete the oldest log file in the directory. -->
	  <maxHistory>30</maxHistory>
    </rollingPolicy>
    <!-- LevelFilter: Accepts INFO only -->
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>INFO</level>
	  <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>
  
  <!-- Configured in the parent <appender> using the <file> tag (e.g., info.log). This is the file currently being written to today. The Rolled File: Configured in the <fileNamePattern>. At midnight, Logback takes the active info.log, renames it to match this pattern (e.g., info-2026-09-07.log), and then creates a brand new, empty info.log for the next day's events.-->
  <!-- 4. ERROR File Appender -->
  <appender name="LOG_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE_ERROR}</file>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOGS_HOME}/error-%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <!-- LevelFilter: Accepts ERROR only -->
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
	  <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>
  
  <!-- 5. Root Logger (Frameworks) -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
  
  <!-- 6. Application Logger (Your Code) -->
  <!-- Process these logs here, and then STOP. Do not pass them up to the root logger. -->
  <logger name="com.masaischool" additivity="false" level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="LOG_INFO"/>
    <appender-ref ref="LOG_ERROR"/>
  </logger>
</configuration>